# Postgres connection string used by Drizzle (src/lib/db.ts)
DATABASE_URL=

# Supabase project settings -> API (https://supabase.com/dashboard/project/_/settings/api)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role key (same page as above) - server-only, used for admin Storage
# operations (src/lib/supabase.ts). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: only needed once you have a Google AdSense account (src/components/AdSlot.astro)
PUBLIC_ADSENSE_CLIENT_ID=
PUBLIC_ADSENSE_SLOT_ID=
