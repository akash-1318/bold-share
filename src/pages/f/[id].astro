---
import Layout from '../../layouts/Layout.astro';
import { db } from '../../lib/db';
import { files } from '../../schema';
import { eq, lt } from 'drizzle-orm';
import { Sparkles, Trash2, Clock, Download, File } from 'lucide-react';
import { unlink } from 'fs/promises';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/');
}

// Cleanup expired files first
const expiredFiles = await db.query.files.findMany({
  where: lt(files.expiresAt, new Date()),
});

for (const f of expiredFiles) {
  try {
    await unlink(f.path);
  } catch (e) {
    console.error('Failed to delete expired file:', f.path);
  }
}
await db.delete(files).where(lt(files.expiresAt, new Date()));

const fileInfo = await db.query.files.findFirst({
  where: eq(files.id, id),
});

if (!fileInfo) {
  return Astro.redirect('/404');
}

const isExpired = fileInfo.expiresAt && new Date() > fileInfo.expiresAt;
---

<Layout>
  <main class="max-w-4xl mx-auto p-4 py-12 space-y-8">
    {isExpired ? (
      <div class="bg-black text-white p-12 neo-brutal text-center space-y-6">
        <Trash2 className="w-24 h-24 mx-auto animate-bounce text-red-500" />
        <h2 class="text-5xl font-black uppercase">This file has self-destructed!</h2>
        <p class="text-xl font-bold opacity-70">The sharing window has closed. All data was securely wiped.</p>
        <div class="pt-6">
          <a href="/" class="bg-[#00F0FF] text-black px-8 py-4 neo-brutal font-black uppercase text-xl inline-block">
            Go back to safety
          </a>
        </div>
      </div>
    ) : (
      <div class="space-y-6">
        <div class="bg-white p-12 neo-brutal text-center space-y-8 animate-in zoom-in duration-300">
          <div class="bg-[#FFFD82] p-8 neo-brutal inline-block">
            <File size={64} className="mx-auto" />
          </div>
          <div class="space-y-2">
            <h2 class="text-4xl font-black break-all">{fileInfo.name}</h2>
            <p class="text-xl font-bold opacity-60">{(fileInfo.size / (1024 * 1024)).toFixed(2)} MB • {fileInfo.type || 'Unknown Type'}</p>
          </div>
          
          <div class="pt-4">
            <a 
              href={`/api/download/${id}`} 
              class="bg-[#00F0FF] text-black text-2xl font-black px-12 py-6 neo-brutal flex items-center justify-center gap-4 hover:bg-[#00D8E6] transition-all group"
              download
            >
              DOWNLOAD NOW <Download className="w-8 h-8 group-hover:translate-y-1 transition-transform" />
            </a>
          </div>
        </div>
        
        {fileInfo.expiresAt && (
          <div class="bg-black text-white p-4 neo-brutal flex items-center gap-3 font-bold justify-center">
            <Clock className="w-6 h-6 text-[#00F0FF]" />
            Expires at: {fileInfo.expiresAt.toLocaleString()}
          </div>
        )}
      </div>
    )}
  </main>
</Layout>
