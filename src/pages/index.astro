---
import Layout from '../layouts/Layout.astro';
import { Sparkles, FileText, Share2, ShieldCheck, Zap, QrCode, ArrowRight, MessageCircle, FilePlus, ChevronDown } from 'lucide-react';
---

<Layout>
  <main class="overflow-hidden">
    <!-- Hero Section -->
    <section class="relative py-24 px-4 bg-[#00F0FF] border-b-8 border-black">
      <div class="max-w-6xl mx-auto text-center space-y-8 relative z-10">
        <div class="inline-block bg-[#FF00E4] text-white px-6 py-2 neo-brutal font-black uppercase tracking-widest text-sm animate-bounce">
          Free & Open Source
        </div>
        <h1 class="text-6xl md:text-8xl font-black uppercase leading-none tracking-tighter">
          Share Boldly. <br />
          <span class="bg-white px-4 inline-block transform -rotate-2 neo-brutal mt-4">Fade Instantly.</span>
        </h1>
        <p class="text-xl md:text-2xl font-bold max-w-2xl mx-auto opacity-90">
          The fastest way to share formatted text and files with anyone. 
          Privacy by design, automatic expiry by default.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-6 pt-8">
          <a href="/text-sharing" class="bg-white text-black px-10 py-5 neo-brutal text-2xl font-black flex items-center gap-3 hover:bg-[#FFFD82] transition-colors">
            SHARE TEXT <FileText className="w-8 h-8" />
          </a>
          <a href="/file-sharing" class="bg-black text-white px-10 py-5 neo-brutal text-2xl font-black flex items-center gap-3 hover:bg-[#FF00E4] transition-colors border-white">
            SHARE FILES <FilePlus className="w-8 h-8" />
          </a>
        </div>
      </div>
      <!-- Decorative background elements -->
      <div class="absolute top-10 left-10 w-32 h-32 bg-[#FF00E4] border-4 border-black rotate-12 -z-0 opacity-20 md:opacity-100"></div>
      <div class="absolute bottom-10 right-10 w-48 h-48 bg-[#FFFD82] rounded-full border-4 border-black -z-0 opacity-20 md:opacity-100"></div>
    </section>

    <!-- Features Section -->
    <section class="py-24 px-4 bg-white">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-5xl font-black uppercase mb-16 text-center underline decoration-[#00F0FF] decoration-8 underline-offset-8">
          Pick Your Tool
        </h2>
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Text Sharing Card -->
          <a href="/text-sharing" class="group bg-[#FFFD82] p-10 neo-brutal hover:-translate-y-4 transition-all duration-300 block relative overflow-hidden">
            <div class="relative z-10 space-y-6">
              <div class="bg-black text-white p-4 w-fit neo-brutal group-hover:rotate-12 transition-transform">
                <FileText className="w-12 h-12" />
              </div>
              <h3 class="text-4xl font-black uppercase">Text Sharing</h3>
              <ul class="space-y-3 font-bold text-lg opacity-80">
                <li class="flex items-center gap-2"><Zap size={20} className="text-black" /> Rich formatting (Bold, Italic, Lists)</li>
                <li class="flex items-center gap-2"><Share2 size={20} className="text-black" /> Instant link & QR code generation</li>
                <li class="flex items-center gap-2"><ShieldCheck size={20} className="text-black" /> Set precise expiry times</li>
              </ul>
              <div class="flex items-center gap-2 font-black uppercase group-hover:gap-4 transition-all">
                Start Writing <ArrowRight />
              </div>
            </div>
          </a>

          <!-- File Sharing Card -->
          <a href="/file-sharing" class="group bg-[#FF00E4] p-10 neo-brutal hover:-translate-y-4 transition-all duration-300 block relative overflow-hidden text-white">
            <div class="relative z-10 space-y-6">
              <div class="bg-white text-black p-4 w-fit neo-brutal group-hover:-rotate-12 transition-transform">
                <FilePlus className="w-12 h-12" />
              </div>
              <h3 class="text-4xl font-black uppercase">File Sharing</h3>
              <ul class="space-y-3 font-bold text-lg opacity-90">
                <li class="flex items-center gap-2"><Zap size={20} /> Upload files up to 100MB</li>
                <li class="flex items-center gap-2"><QrCode size={20} /> Share via link or secure QR</li>
                <li class="flex items-center gap-2"><ShieldCheck size={20} /> Automatic file deletion on expiry</li>
              </ul>
              <div class="flex items-center gap-2 font-black uppercase group-hover:gap-4 transition-all">
                Upload Now <ArrowRight />
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-24 px-4 bg-[#F0F0F0] border-t-8 border-black">
      <div class="max-w-4xl mx-auto space-y-12">
        <h2 class="text-5xl font-black uppercase text-center">Common Questions</h2>
        <div class="space-y-6">
          {[
            { q: "What is BoldShare?", a: "BoldShare is a privacy-first platform for temporary data sharing. Create formatted text snippets or upload files that exist only as long as you want them to." },
            { q: "How long do links remain available?", a: "You decide! Set expiry from 15 minutes up to 24 hours. After that, they are gone forever." },
            { q: "Is it secure?", a: "Absolutely. We don't track who you are. Content is automatically deleted from our servers the moment it expires." },
            { q: "What's the maximum file size?", a: "Currently, you can upload files up to 100MB for free." }
          ].map((item, i) => (
            <div class="bg-white p-8 neo-brutal group hover:bg-[#FFFD82] transition-colors cursor-pointer">
              <div class="flex justify-between items-center">
                <h4 class="text-2xl font-black uppercase">{item.q}</h4>
                <ChevronDown className="group-hover:rotate-180 transition-transform" />
              </div>
              <p class="mt-4 font-bold opacity-70 group-hover:opacity-100 transition-opacity">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-black text-white py-20 px-4 border-t-8 border-[#FF00E4]">
      <div class="max-w-6xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-12">
        <div class="space-y-6">
          <h5 class="text-xl font-black uppercase text-[#00F0FF]">Tools</h5>
          <ul class="space-y-2 font-bold opacity-70">
            <li><a href="/text-sharing" class="hover:text-[#FF00E4]">Text Sharing</a></li>
            <li><a href="/file-sharing" class="hover:text-[#FF00E4]">File Sharing</a></li>
          </ul>
        </div>
        <div class="space-y-6">
          <h5 class="text-xl font-black uppercase text-[#00F0FF]">Support</h5>
          <ul class="space-y-2 font-bold opacity-70">
            <li><a href="#" class="hover:text-[#FF00E4]">Help Center</a></li>
            <li><a href="#" class="hover:text-[#FF00E4]">FAQ</a></li>
            <li><a href="#" class="hover:text-[#FF00E4]">Contact Support</a></li>
          </ul>
        </div>
        <div class="space-y-6">
          <h5 class="text-xl font-black uppercase text-[#00F0FF]">Contact</h5>
          <ul class="space-y-2 font-bold opacity-70">
            <li><a href="#" class="hover:text-[#FF00E4]">Contact Us</a></li>
            <li><a href="#" class="hover:text-[#FF00E4]">Email Support</a></li>
          </ul>
        </div>
        <div class="space-y-6">
          <h5 class="text-xl font-black uppercase text-[#00F0FF]">Legal</h5>
          <ul class="space-y-2 font-bold opacity-70">
            <li><a href="#" class="hover:text-[#FF00E4]">Terms of Service</a></li>
            <li><a href="#" class="hover:text-[#FF00E4]">Privacy Policy</a></li>
            <li><a href="#" class="hover:text-[#FF00E4]">Cookie Policy</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-6xl mx-auto mt-20 pt-8 border-t border-white/20 text-center font-bold opacity-50">
        &copy; 2026 BoldShare. Built with high-voltage energy.
      </div>
    </footer>
  </main>
</Layout>
