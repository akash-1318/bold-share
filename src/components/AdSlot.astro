---
const clientId = import.meta.env.PUBLIC_ADSENSE_CLIENT_ID;
const slotId = import.meta.env.PUBLIC_ADSENSE_SLOT_ID;
---

{clientId && (
  <div class="my-6">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={clientId}
      data-ad-slot={slotId}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${clientId}`} crossorigin="anonymous" is:inline></script>
    <script is:inline>
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.push({});
    </script>
  </div>
)}
